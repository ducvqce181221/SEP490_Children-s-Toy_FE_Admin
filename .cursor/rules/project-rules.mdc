## File Templates

### New Feature Hook
```ts
// src/features/<feature>/hooks/use<Feature>.ts
"use client"; // only if used in client component
import { useState, useEffect } from "react";
import { featureApi } from "../services/<feature>-api";
import type { Feature } from "../types/<feature>.schema";
import toast from "react-hot-toast";

export const use<Feature> = () => {
  const [data, setData] = useState<Feature[]>([]);
  const [isLoading, setIsLoading] = useState(true);
  const [error, setError] = useState<string | null>(null);

  useEffect(() => {
    let cancelled = false;
    const load = async () => {
      setIsLoading(true);
      setError(null);
      try {
        const result = await featureApi.getAll();
        if (!cancelled) setData(result);
      } catch (err) {
        if (!cancelled) {
          const msg = err instanceof Error ? err.message : "Tải dữ liệu thất bại";
          setError(msg);
          toast.error(msg);
        }
      } finally {
        if (!cancelled) setIsLoading(false);
      }
    };
    load();
    return () => { cancelled = true; };
  }, []);

  return { data, isLoading, error };
};
```

### New Zod Schema
```ts
// src/features/<feature>/types/<feature>.schema.ts
import { z } from "zod";

export const <Feature>FormSchema = z.object({
  name: z.string().min(2, "Tên phải có ít nhất 2 ký tự"),
  // ... other fields
});

export type <Feature>FormData = z.infer<typeof <Feature>FormSchema>;
```

### New API Service
```ts
// src/features/<feature>/services/<feature>-api.ts
import axiosClient from "@/configs/axios-client";
import type { <Feature>FormData } from "../types/<feature>.schema";

export const <feature>Api = {
  getAll: () => axiosClient.get("/<feature>s"),
  getById: (id: number) => axiosClient.get(`/<feature>s/${id}`),
  create: (data: <Feature>FormData) => axiosClient.post("/<feature>s", data),
  update: (id: number, data: <Feature>FormData) => axiosClient.put(`/<feature>s/${id}`, data),
  delete: (id: number) => axiosClient.delete(`/<feature>s/${id}`),
};
```
